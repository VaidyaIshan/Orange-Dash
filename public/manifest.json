{
  "manifest_version": 3,
  "name": "orangedash",
  "version": "1.0.0",
  "description": "A minimalistic chrome extension to elevate tab design and track screen time",
  "action": {
    "default_popup": "index.html",
    "default_icon": "android-chrome-512x512.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["tabs", "storage", "activeTab", "alarms", "notifications", "declarativeNetRequest"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.reddit.com/*",
    "*://*.tiktok.com/*",
    "*://*.netflix.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "icons": {
    "48": "android-chrome-512x512.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}